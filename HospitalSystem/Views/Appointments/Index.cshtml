@model List<Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 fw-bold mb-1">Appointments</h1>
        <p class="text-muted mb-0">@Model.Count booked appointment(s)</p>
    </div>
    <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Make Appointment
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted" aria-hidden="true"></i>
        <p class="mt-3 text-muted">No appointments booked yet.</p>
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary">Book your first appointment</a>
    </div>
}
else
{
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Patient Name</th>
                        <th scope="col">Doctor Name</th>
                        <th scope="col">Specialization</th>
                        <th scope="col">Date</th>
                        <th scope="col">Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@a.PatientName</td>
                            <td>@a.Doctor?.Name</td>
                            <td><span class="badge specialty-badge">@a.Doctor?.Specialization</span></td>
                            <td>@a.AppointmentDate.ToString("ddd, dd/MM/yyyy")</td>
                            <td>@ScheduleRules.Format(a.AppointmentTime)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
