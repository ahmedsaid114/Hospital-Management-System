@model DoctorListViewModel
@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
    <div>
        <h1 class="h2 fw-bold mb-1">Find a doctor</h1>
        <p class="text-muted mb-0">@Model.TotalCount doctor(s) available</p>
    </div>
</div>

<form method="get" asp-action="Index" class="filter-bar row g-2 align-items-end mb-4" role="search">
    <div class="col-md-5">
        <label for="name" class="form-label small fw-semibold">Doctor name</label>
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
            <input type="text" id="name" name="name" value="@Model.Name" class="form-control" placeholder="e.g. Ahmed" />
        </div>
    </div>
    <div class="col-md-4">
        <label for="specialization" class="form-label small fw-semibold">Specialization</label>
        <select id="specialization" name="specialization" class="form-select">
            <option value="">All specializations</option>
            @foreach (var s in Model.Specializations)
            {
                <option value="@s" selected="@(s == Model.Specialization)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (!Model.Doctors.Any())
{
    <div class="empty-state text-center py-5">
        <i class="bi bi-person-x fs-1 text-muted" aria-hidden="true"></i>
        <p class="mt-3 text-muted">No doctors match your filters.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var doctor in Model.Doctors)
        {
            <div class="col-sm-6 col-lg-3">
                <article class="card doctor-card h-100">
                    <img src="@doctor.ImageUrl" class="card-img-top" alt="Portrait of @doctor.Name" />
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 fw-semibold mb-1">@doctor.Name</h2>
                        <span class="badge specialty-badge align-self-start mb-3">@doctor.Specialization</span>
                        <a asp-controller="Appointments" asp-action="Book" asp-route-id="@doctor.Id"
                           class="btn btn-primary mt-auto">
                            <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Book Appointment
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Doctors pagination" class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                       asp-route-name="@Model.Name" asp-route-specialization="@Model.Specialization">Previous</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")" aria-current="@(i == Model.Page ? "page" : null)">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-name="@Model.Name" asp-route-specialization="@Model.Specialization">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                       asp-route-name="@Model.Name" asp-route-specialization="@Model.Specialization">Next</a>
                </li>
            </ul>
        </nav>
    }
}
