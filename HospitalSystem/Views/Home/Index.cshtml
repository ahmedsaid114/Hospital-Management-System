@{
    ViewData["Title"] = "Home";
}

<section class="hero rounded-4 p-4 p-md-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge rounded-pill text-bg-light text-primary mb-3 px-3 py-2">
                <i class="bi bi-calendar-check me-1" aria-hidden="true"></i> Online booking
            </span>
            <h1 class="display-5 fw-bold mb-3 text-balance">Your health, booked in minutes.</h1>
            <p class="lead text-muted mb-4">
                Browse our specialists, pick a time that suits you, and manage all your appointments in one place.
            </p>
            <div class="d-flex flex-column flex-sm-row gap-3">
                <a class="btn btn-primary btn-lg px-4" asp-controller="Doctors" asp-action="Index">
                    <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Make Appointment
                </a>
                <a class="btn btn-outline-primary btn-lg px-4" asp-controller="Appointments" asp-action="Index">
                    <i class="bi bi-list-check me-2" aria-hidden="true"></i>View Appointments
                </a>
            </div>
        </div>
        <div class="col-lg-6">
            <img src="~/images/hero.png" alt="Friendly doctor greeting a patient in a bright clinic"
                 class="img-fluid rounded-4 shadow-sm w-100 hero-img" />
        </div>
    </div>
</section>

<section class="row g-4 mt-4" aria-label="Clinic information">
    <div class="col-md-4">
        <div class="info-card h-100">
            <i class="bi bi-people fs-3 text-primary" aria-hidden="true"></i>
            <h2 class="h6 fw-semibold mt-3">Trusted specialists</h2>
            <p class="text-muted small mb-0">Cardiology, pediatrics, neurology and more under one roof.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-card h-100">
            <i class="bi bi-calendar-week fs-3 text-primary" aria-hidden="true"></i>
            <h2 class="h6 fw-semibold mt-3">Sunday – Thursday</h2>
            <p class="text-muted small mb-0">Appointments available on all working days of the week.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="info-card h-100">
            <i class="bi bi-clock fs-3 text-primary" aria-hidden="true"></i>
            <h2 class="h6 fw-semibold mt-3">30-minute slots</h2>
            <p class="text-muted small mb-0">Choose any slot from 9:00 AM to 4:30 PM.</p>
        </div>
    </div>
</section>
